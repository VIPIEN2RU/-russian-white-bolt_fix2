{
  "name": "vpnbolt",
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "configs/**/*.txt",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/checker.html",
      "dest": "/checker.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
